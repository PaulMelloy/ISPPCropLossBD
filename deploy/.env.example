# Copy to deploy/.env and edit every value marked CHANGE. Never commit .env.
# Generate secrets with:  openssl rand -hex 24
# Use hex secrets: they are placed inside a connection URL, so characters such
# as @ : / # would break it.

# CHANGE: public hostname, with a DNS A record pointing at this server
CROPLOSS_DOMAIN=croploss.example.org

# CHANGE: password for the database owner (used only to build the schema)
POSTGRES_PASSWORD=change-me

# CHANGE: password for the restricted croploss_app role the web app uses
APP_PASSWORD=change-me

# Admin password sign-in, for using the app before ORCID is set up.
# CHANGE: your own ORCID iD. Everything you enter is attributed to it.
CROPLOSS_ADMIN_ORCID=
# CHANGE: at least 16 characters (openssl rand -hex 16). Empty it to turn
# password sign-in off once ORCID sign-in works.
CROPLOSS_ADMIN_PASSWORD=change-me

# ORCID sign-in. Leave the ID and secret empty until you register with ORCID
# (docs/DEPLOY.md step 8); the "Sign in with ORCID" button appears once both
# are set. The redirect URI registered there must be exactly
#   https://<CROPLOSS_DOMAIN>/
# "production" for real ORCID, or "sandbox" if you registered with the sandbox
ORCID_ENV=production
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# CHANGE: long random string that signs the OAuth state (openssl rand -hex 32)
CROPLOSS_STATE_SECRET=change-me
